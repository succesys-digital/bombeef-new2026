---
import { Image } from 'astro:assets';
import '@fontsource/alfa-slab-one/400.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow-condensed/600.css';
import '../styles/global.css';
import slabFont from '@fontsource/alfa-slab-one/files/alfa-slab-one-latin-400-normal.woff2?url';
import logo from '../assets/brand/logo.png';
import ogImage from '../assets/photos/mesa.jpg';
import { company } from '../data/franchise';

interface Props { title: string; description: string; noindex?: boolean; canonical?: string; jsonLd?: object; preloadBurger?: boolean }
const { title, description, noindex, canonical, jsonLd, preloadBurger } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/cardapio/', label: 'Cardápio' },
  { href: '/unidades/', label: 'Unidades' },
  { href: '/netao/', label: 'O Netão' },
  { href: '/videos/', label: 'Vídeos' },
];
const current = (h: string) => (path.startsWith(h) ? 'page' : undefined);
const url = canonical ?? new URL(path, Astro.site).href;
const og = new URL(ogImage.src, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bom Beef Burgers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preload" href={slabFont} as="font" type="font/woff2" crossorigin />
    {preloadBurger && <link rel="preload" href="/burger/big-neto-800.webp" as="image" imagesrcset="/burger/big-neto-800.webp 800w, /burger/big-neto.webp 1200w" imagesizes="(min-width: 900px) 66vw, 96vw" fetchpriority="high" />}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="header">
      <div class="wrap header__in">
        <a class="logo" href="/" aria-label="Bom Beef Burgers, página inicial">
          <Image src={logo} alt="" width={100} height={100} loading="eager" />
        </a>
        <nav class="nav" aria-label="Principal">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
        </nav>
        <div class="header__cta">
          <a class="btn" href="/quero-ser-franqueado/">Quero ser franqueado</a>
          <button class="burger-btn" type="button" data-menu-open aria-label="Abrir menu"><span></span><span></span><span></span></button>
        </div>
      </div>
    </header>
    <dialog class="menu" data-menu aria-label="Menu">
      <button class="menu__close" type="button" data-menu-close>Fechar</button>
      <ul class="menu__list">
        <li><a href="/">Início</a></li>
        {nav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
        <li><a href="/quero-ser-franqueado/" aria-current={current('/quero-ser-franqueado/')}>Quero ser franqueado</a></li>
      </ul>
    </dialog>

    <main id="conteudo"><slot /></main>

    <footer class="footer">
      <div class="wrap">
        <p class="footer__big"><span>Burgers bons pra K7</span>− Gourmet<br />+ Qualidade</p>
        <div class="footer__grid">
          <nav aria-label="Rodapé: site">
            <h2>Bom Beef Burgers</h2>
            <ul>
              <li><a href="/cardapio/">Cardápio</a></li>
              <li><a href="/unidades/">Unidades</a></li>
              <li><a href="/netao/">O Netão</a></li>
              <li><a href="/videos/">Vídeos</a></li>
            </ul>
          </nav>
          <nav aria-label="Rodapé: franquias">
            <h2>Franquias</h2>
            <ul>
              <li><a href="/quero-ser-franqueado/">Franquia Burgers</a></li>
              <li><a href={company.acougues} rel="noopener">Franquia Açougues</a></li>
              <li><a href="/trabalhe-conosco/">Trabalhe conosco</a></li>
            </ul>
          </nav>
          <nav aria-label="Rodapé: redes">
            <h2>Redes</h2>
            <ul>
              <li><a href={company.youtube} rel="noopener">YouTube do Netão</a></li>
              <li><a href={company.instagramNetao} rel="noopener">Instagram do Netão</a></li>
              <li><a href={company.instagramBrand} rel="noopener">Instagram da Bom Beef</a></li>
            </ul>
          </nav>
          <nav aria-label="Rodapé: contato">
            <h2>Contato</h2>
            <ul>
              <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
              <li><a href="/politica-de-privacidade/">Política de privacidade</a></li>
            </ul>
          </nav>
        </div>
        <p class="footer__legal">{company.legalName}, CNPJ {company.cnpj}. {company.address}. Imagens dos produtos meramente ilustrativas.</p>
      </div>
    </footer>

    <div class="consent" data-consent role="region" aria-label="Preferências de cookies" hidden>
      <p>Usamos cookies de medição para entender o que funciona no site. Saiba mais na <a href="/politica-de-privacidade/">política de privacidade</a>.</p>
      <div class="actions">
        <button class="btn btn--ink" type="button" data-consent-value="yes">Aceitar</button>
        <button class="btn btn--plain" type="button" data-consent-value="no">Recusar</button>
      </div>
    </div>
    <script>import '../scripts/site';</script>
  </body>
</html>
