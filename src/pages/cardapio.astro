---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import menu from '../data/menu.json';
import { company } from '../data/franchise';
const cut = import.meta.glob<{ default: ImageMetadata }>('../assets/menu/*.png', { eager: true });
const id = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z]+/g, '-');
---
<Base title="Cardápio | Bom Beef Burgers" description="Fininho, Grelha, Wagyu e mais: conheça os burgers, acompanhamentos, molhos e sobremesas da Bom Beef Burgers.">
  <div class="wrap page-head">
    <h1 class="display">O cardápio do Netão</h1>
    <p class="lede muted">Disponibilidade e preços variam por unidade. Para pedir, abra o cardápio digital ou fale com a loja mais perto de você.</p>
    <div class="actions" style="margin-top:1.5rem">
      <a class="btn" href={company.menu} rel="noopener">Abrir o cardápio digital</a>
      <a class="btn btn--plain" href="/unidades/">Encontrar uma unidade</a>
    </div>
  </div>
  <div class="wrap" style="padding-bottom:clamp(4rem,10vw,8rem)">
    <nav class="menu-nav" aria-label="Seções do cardápio">
      {menu.map((s) => <a href={`#${id(s.title)}`}>{s.title}</a>)}
    </nav>
    {menu.map((s) => (
      <section class="menu-sec" id={id(s.title)} aria-labelledby={`h-${id(s.title)}`}>
        <h2 class="title" id={`h-${id(s.title)}`}>{s.title}</h2>
        <ul class="menu-grid">
          {s.items.map((i) => {
            const src = cut[`../assets/menu/${i.code}.png`]?.default;
            return (
              <li class="item">
                {src && <Image src={src} alt="" widths={[300, 500].filter((w) => w <= src.width)} sizes="(min-width: 700px) 25vw, 100vw" loading="lazy" />}
                <h3>{i.title}</h3>
                {i.desc && <p>{i.desc}</p>}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
    <p class="muted small" style="margin-top:3rem">Imagens meramente ilustrativas.</p>
  </div>
</Base>
