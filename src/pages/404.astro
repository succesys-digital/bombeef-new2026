---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | Bom Beef Burgers" description="Esta página não existe." noindex>
  <section class="on-orange" style="min-height:70svh;display:grid;align-items:center">
    <div class="wrap section">
      <h1 class="display">Esse corte acabou</h1>
      <p class="lede" style="margin-block:1.5rem">A página que você procurou não existe ou mudou de endereço.</p>
      <div class="actions">
        <a class="btn btn--ink" href="/">Voltar ao início</a>
        <a class="btn btn--plain" href="/unidades/">Ver as unidades</a>
      </div>
    </div>
  </section>
</Base>
