---
import { UFS, INVESTMENT } from '../lib/lead';
---
<form class="lead" data-lead action="/api/lead" method="post">
  <div class="field wide">
    <label for="lead-name">Nome completo</label>
    <input id="lead-name" name="name" autocomplete="name" required minlength="2" maxlength="160" aria-describedby="err-name" />
    <p class="field__error" id="err-name"></p>
  </div>
  <div class="field">
    <label for="lead-phone">Celular / WhatsApp, com DDD</label>
    <input id="lead-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" required pattern="[\d\s()+\-]{10,20}" maxlength="20" placeholder="(11) 91234-5678" aria-describedby="err-phone" />
    <p class="field__error" id="err-phone"></p>
  </div>
  <div class="field">
    <label for="lead-email">Email</label>
    <input id="lead-email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="err-email" />
    <p class="field__error" id="err-email"></p>
  </div>
  <div class="field wide field--two">
    <div class="field">
      <label for="lead-city">Cidade onde quer abrir</label>
      <input id="lead-city" name="city" autocomplete="address-level2" required minlength="2" maxlength="120" aria-describedby="err-city" />
      <p class="field__error" id="err-city"></p>
    </div>
    <div class="field">
      <label for="lead-state">Estado</label>
      <select id="lead-state" name="state" required autocomplete="address-level1" aria-describedby="err-state">
        <option value="">UF</option>
        {UFS.map((u) => <option>{u}</option>)}
      </select>
      <p class="field__error" id="err-state"></p>
    </div>
  </div>
  <div class="field wide">
    <label for="lead-inv">Valor disponível para investir</label>
    <select id="lead-inv" name="investment" required aria-describedby="err-inv">
      <option value="">Selecione</option>
      {INVESTMENT.map((i) => <option>{i}</option>)}
    </select>
    <p class="field__error" id="err-inv"></p>
  </div>
  <div class="field wide">
    <label class="check" style="font: inherit">
      <input type="checkbox" name="consent" required aria-describedby="err-consent" />
      <span>Aceito receber contato do time de expansão e li a <a href="/politica-de-privacidade/">política de privacidade</a>.</span>
    </label>
    <p class="field__error" id="err-consent"></p>
  </div>
  <div class="hp" aria-hidden="true">
    <label>Site <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="started" value="" />
  <input type="hidden" name="utm_source" /><input type="hidden" name="utm_medium" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="utm_term" />
  <div class="wide actions">
    <button class="btn btn--ink" type="submit">Enviar meu cadastro</button>
    <p class="status" data-status role="status"></p>
  </div>
</form>
