---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/stores/*', { eager: true });
interface Props { file: string; name: string; eager?: boolean; sizes?: string }
const { file, name, eager, sizes = '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 100vw' } = Astro.props;
const src = photos[`../assets/stores/${file}`]?.default;
---
{src && <Image src={src} alt={`Unidade Bom Beef Burgers ${name}`} widths={[320, 640].filter((w) => w <= src.width)} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />}
